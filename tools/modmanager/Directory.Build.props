<Project>
  <!-- Gemeinsame Einstellungen fuer alle Projekte des Mod-Managers.
       <Version> ist die Manager-Version. Bei jeder Aenderung erhoehen und
       tools/modmanager/CHANGELOG.md ergaenzen (Release-Workflow liest beides). -->
  <PropertyGroup>
    <Version>1.1.0</Version>
    <Product>RE:Multiplayer Mod-Manager</Product>
    <Company>RE:Multiplayer</Company>
    <Copyright>MIT-Lizenz</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
