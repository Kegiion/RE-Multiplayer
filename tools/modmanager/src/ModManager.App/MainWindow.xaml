<Window x:Class="REMultiplayer.ModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:REMultiplayer.ModManager"
        Title="RE:Multiplayer Mod-Manager"
        Width="920" Height="660" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid x:Name="Root" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <Grid Grid.Row="0" Margin="32,26,32,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="RE" FontSize="30" FontWeight="Black" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text=":" FontSize="30" FontWeight="Black" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="MULTIPLAYER" FontSize="30" FontWeight="Black" />
                </StackPanel>
                <TextBlock Text="{l:T header.subtitle}" Foreground="{StaticResource TextMutedBrush}" Margin="1,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="{l:T header.beta}" IsChecked="{Binding IncludePrereleases}" Margin="0,0,20,0"
                          ToolTip="{l:T header.betaTip}" />
                <Button Content="{l:T header.refresh}" Style="{StaticResource BaseButton}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- Update des Managers -->
        <Border Grid.Row="1" Margin="32,0,32,16" Padding="18,12" CornerRadius="8"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding ManagerUpdateVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{l:T update.whatsNew}" Style="{StaticResource LinkButton}" Command="{Binding ShowManagerNotesCommand}" />
                    <Button Content="{l:T update.now}" Style="{StaticResource PrimaryButton}" Command="{Binding UpdateManagerCommand}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ManagerUpdateText}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:T update.subtitle}" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Spiele -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="32,0,24,0">
            <ItemsControl ItemsSource="{Binding Games}" Margin="0,0,8,8" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="22,18" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- WrapPanel: bei schmalem Fenster rutscht das Badge unter den Namen statt unter die Knoepfe -->
                                <WrapPanel Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <Border x:Name="Badge" CornerRadius="10" Padding="10,2" Margin="0,3,0,0" BorderThickness="1"
                                            BorderBrush="{StaticResource LineBrush}" VerticalAlignment="Center">
                                        <TextBlock x:Name="BadgeText" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </Border>
                                </WrapPanel>

                                <TextBlock Grid.Row="1" Text="{Binding FolderText}" ToolTip="{Binding FolderText}"
                                           Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,6,16,0" />

                                <TextBlock Grid.Row="2" Text="{Binding VersionText}" Margin="0,10,16,0" TextWrapping="Wrap" />

                                <StackPanel Grid.Column="1" Grid.RowSpan="3" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="{l:T card.uninstall}" Style="{StaticResource BaseButton}" Margin="0,0,10,0"
                                            Command="{Binding UninstallCommand}"
                                            Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="{Binding PrimaryText}" Style="{StaticResource ActionButton}"
                                            MinWidth="128" Command="{Binding PrimaryCommand}" />
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding HintText}" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,0"
                                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />

                                <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                                        Margin="0,14,0,0" Padding="0,10,0,0">
                                    <WrapPanel>
                                        <Button Content="{l:T card.notes}" Style="{StaticResource LinkButton}" Command="{Binding NotesCommand}" />
                                        <Button Content="{l:T card.report}" Style="{StaticResource LinkButton}" Command="{Binding ReportCommand}" />
                                        <Button Content="{l:T card.openFolder}" Style="{StaticResource LinkButton}" Command="{Binding OpenFolderCommand}" />
                                        <Button Content="{l:T card.chooseFolder}" Style="{StaticResource LinkButton}" Command="{Binding ChooseFolderCommand}" />
                                    </WrapPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="UpdateAvailable">
                                <Setter TargetName="Badge" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="BadgeText" Property="Foreground" Value="White" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#66C8102E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Installed">
                                <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource TextBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Fusszeile -->
        <Grid Grid.Row="3">
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="32,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ManagerVersionText}" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <!-- Sprache: Automatisch (Windows) oder fest, wird gespeichert -->
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Languages}" DisplayMemberPath="Display"
                              SelectedValuePath="Code" SelectedValue="{Binding LanguageChoice}"
                              ToolTip="{l:T header.languageTip}" Margin="0,-4,18,-4" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                               Margin="0,0,16,0" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <!-- Fortschritt liegt auf der Trennlinie, damit nichts springt -->
            <ProgressBar VerticalAlignment="Top" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Background="Transparent"
                         Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</Window>
