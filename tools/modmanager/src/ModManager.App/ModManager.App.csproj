<Project Sdk="Microsoft.NET.Sdk">

  <!-- Die Manager-exe (WPF). Wird als eine einzige, eigenstaendige Datei veroeffentlicht,
       der genaue publish-Befehl steht in .github/workflows/modmanager.yml und tools/modmanager/README.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>REMods-Manager</AssemblyName>
    <RootNamespace>REMods.ModManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModManager.Core\ModManager.Core.csproj" />
  </ItemGroup>

</Project>
