<Window x:Class="REMods.ModManager.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patch Notes" Width="640" Height="560" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="28,22,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,8,12">
            <TextBlock Text="PATCH NOTES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" />
        </StackPanel>
        <FlowDocumentScrollViewer x:Name="Viewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False" />
        <Button Grid.Row="2" Content="Schließen" Style="{StaticResource BaseButton}" HorizontalAlignment="Right"
                Margin="0,14,8,0" IsCancel="True" IsDefault="True" Click="Close_Click" />
    </Grid>
</Window>
