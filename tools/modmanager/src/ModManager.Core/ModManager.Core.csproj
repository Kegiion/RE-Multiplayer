<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plattformunabhaengiger Kern (laeuft auch unter Linux, dort laufen die Tests).
       Windows-spezifisches (Registry) ist mit OperatingSystem.IsWindows() abgesichert. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>REMultiplayer.ModManager.Core</RootNamespace>
    <AssemblyName>REMultiplayer.ModManager.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\games.json" LogicalName="games.json" />
    <!-- Sprachen: jede Datei in tools/modmanager/lang wird eingebaut, neue Sprache = neue Datei -->
    <EmbeddedResource Include="..\..\lang\*.json" LogicalName="lang/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
